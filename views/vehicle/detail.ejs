<%- include('../partials/header') %>
<section class="hero compact">
    <p class="eyebrow">ARAÇ DETAYI · <%= vehicle.year %></p>
    <h1><%= vehicle.brand %> <%= vehicle.model %></h1>
    <p><%= vehicle.engine %> · <%= vehicle.power %> bg · <%= vehicle.fuel %></p>
</section>

<section class="section detail-grid">
    <div>
        <p class="eyebrow">TEKNİK ÖZET</p>
        <h2>Aracın temel bilgileri</h2>

        <dl>
            <dt>Model yılı</dt>
            <dd><%= vehicle.year %></dd>

            <dt>Motor</dt>
            <dd><%= vehicle.engine %></dd>

            <dt>Yakıt</dt>
            <dd><%= vehicle.fuel %></dd>

            <dt>Güç</dt>
            <dd><%= vehicle.power %> bg</dd>
        </dl>
    </div>

    <div class="note">
        <p class="eyebrow">TOPLULUK NOTU</p>
        <h3>Kullanıcıların dikkat çektiği konu</h3>
        <p><%= vehicle.knownIssue %></p>
        <span class="tag">Önem seviyesi: <%= vehicle.issueLevel %></span>
        <p class="muted">Bu bilgi kullanıcı katkısı niteliğindedir; araç ve bakım geçmişine göre değişebilir.</p>
    </div>
</section>

<section class="section">
    <p class="eyebrow">KULLANICI DENEYİMLERİ</p>
    <h2>Sahiplerden kısa notlar</h2>
    <p class="muted">Bu model için inceleme alanı hazır. Sonraki aşamada doğrulanmış kullanıcı katkıları eklenecek.</p>
</section>
<%- include('../partials/footer') %>
