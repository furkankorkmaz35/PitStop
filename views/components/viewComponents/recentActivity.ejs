<!--
  VIEWCOMPONENT GÖRÜNÜMÜ: recentActivity.ejs
  Mimari Rol: ViewComponent Şablonu
  
  Bu görünüm, RecentActivityViewComponent tarafından bağımsız olarak çekilen
  son kullanıcı girdilerini ve paylaşımlarını listeler.
-->
<div class="viewcomponent-card recent-activity-box" role="region" aria-label="Son Topluluk Aktiviteleri" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-5);">
    <div style="margin-bottom: var(--space-3);">
        <p class="eyebrow" style="margin: 0; font-size: 0.6875rem;">TOPLULUK AKIŞI · VIEWCOMPONENT</p>
        <h4 style="margin: 4px 0 0; font-size: 1.1rem; color: var(--color-text);"><%= title %></h4>
    </div>

    <% if (hasActivities) { %>
        <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3);">
            <% activities.forEach(act => { %>
                <li style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-3); background: var(--color-raised); border-radius: var(--radius-sm); border: 1px solid var(--color-border); font-size: var(--text-xs);">
                    <div style="min-width: 0; padding-right: var(--space-2);">
                        <strong style="color: var(--color-text); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= act.vehicle %></strong>
                        <span class="muted" style="font-size: 0.6875rem;"><%= act.operation %> · <%= act.date %></span>
                    </div>
                    <span class="tag tag--accent" style="font-weight: 600; white-space: nowrap;">₺<%= Number(act.cost || 0).toLocaleString('tr-TR') %></span>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p class="muted" style="font-size: var(--text-sm); margin: 0;">Henüz kullanıcı aktivitesi bulunmuyor.</p>
    <% } %>
</div>
