<%- include('../partials/header') %>
<section class="hero compact">
    <p class="eyebrow">BAKIM GEÇMİŞİ</p>
    <h1>Harcamalarını takip et.</h1>
    <p>Bakım tarihlerini ve maliyetlerini tek yerde gör.</p>
</section>

<section class="section">
    <div class="section-head">
        <div>
            <p class="eyebrow">ÖRNEK GARAJ</p>
            <h2>Son bakım kayıtları</h2>
        </div>
        <strong class="total">Toplam ₺<%= totalCost.toLocaleString("tr-TR") %></strong>
    </div>

    <div class="table-wrap" role="region" aria-label="<%= title %> tablosu" tabindex="0">
        <table>
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Araç</th>
                    <th>İşlem</th>
                    <th>Parça</th>
                    <th>Servis</th>
                    <th>Maliyet</th>
                </tr>
            </thead>
            <tbody>
                <% logs.forEach(log => { %>
                    <tr>
                        <td><%= log.date %></td>
                        <td><strong><%= log.vehicle %></strong></td>
                        <td><%= log.operation %></td>
                        <td><%= log.part %></td>
                        <td><%= log.service %></td>
                        <td><strong>₺<%= log.cost.toLocaleString("tr-TR") %></strong></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <p class="muted">Görünen kayıtlar örnek amaçlıdır.</p>
</section>
<%- include('../partials/footer') %>
