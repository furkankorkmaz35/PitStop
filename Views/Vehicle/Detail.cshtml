@model PitStop.Models.Vehicle

@{
    ViewData["Title"] = "Araç Detayı";
}

<section class="hero compact">
    <p class="eyebrow">ARAÇ DETAYI · @Model.Year</p>
    <h1>@Model.Brand @Model.Model</h1>
    <p>@Model.Engine · @Model.Power bg · @Model.Fuel</p>
</section>

<section class="section detail-grid">
    <div>
        <p class="eyebrow">TEKNİK ÖZET</p>
        <h2>Aracın temel bilgileri</h2>

        <dl>
            <dt>Model yılı</dt>
            <dd>@Model.Year</dd>

            <dt>Motor</dt>
            <dd>@Model.Engine</dd>

            <dt>Yakıt</dt>
            <dd>@Model.Fuel</dd>

            <dt>Güç</dt>
            <dd>@Model.Power bg</dd>
        </dl>
    </div>

    <div class="note">
        <p class="eyebrow">TOPLULUK NOTU</p>
        <h3>Kullanıcıların dikkat çektiği konu</h3>
        <p>@Model.KnownIssue</p>
        <span class="tag">Önem seviyesi: @Model.IssueLevel</span>
        <p class="muted">Bu bilgi kullanıcı katkısı niteliğindedir; araç ve bakım geçmişine göre değişebilir.</p>
    </div>
</section>

<section class="section">
    <p class="eyebrow">KULLANICI DENEYİMLERİ</p>
    <h2>Sahiplerden kısa notlar</h2>
    <p class="muted">Bu model için inceleme alanı hazır. Sonraki aşamada doğrulanmış kullanıcı katkıları eklenecek.</p>
</section>
