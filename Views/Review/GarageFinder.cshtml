@model IEnumerable<PitStop.Models.Garage>

@{
    ViewData["Title"] = "Servis Bul";
}

<section class="hero compact">
    <p class="eyebrow">USTA VE SERVİS REHBERİ</p>
    <h1>Aracını bilen servisi bul.</h1>
    <p>Şehir ve marka uzmanlığına göre önerileri incele.</p>

    <form method="get" class="filters">
        <input name="city" placeholder="Şehir ara" />
        <button type="submit">Servis ara</button>
    </form>
</section>

<section class="section">
    <p class="eyebrow">ÖRNEK LİSTE</p>
    <h2>Servis önerileri</h2>

    <div class="guide-list">
        @foreach (var garage in Model)
        {
            <article class="guide">
                <div>
                    <span class="eyebrow">@garage.City · @garage.Brands</span>
                    <h3>@garage.Name</h3>
                    <p>@garage.Specialty</p>
                </div>
                <strong>★ @garage.Score</strong>
            </article>
        }
    </div>

    <p class="muted">Örnek işletmeler temsili veridir; gerçek öneriler kullanıcı katkısıyla doğrulanacaktır.</p>
</section>
