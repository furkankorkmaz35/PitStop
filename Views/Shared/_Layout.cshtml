<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · PitStop</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="top">
        <a class="brand" asp-controller="Vehicle" asp-action="Catalog">PITSTOP<span>.</span></a>

        <nav aria-label="Ana menü">
            <a asp-controller="Vehicle" asp-action="Catalog">Araç Kataloğu</a>
            <a asp-controller="Vehicle" asp-action="Detail">Araç Detayı</a>
            <a asp-controller="Maintenance" asp-action="Logs">Bakım Kayıtları</a>
            <a asp-controller="Maintenance" asp-action="Guide">DIY Rehber</a>
            <a asp-controller="Review" asp-action="PartReviews">Parça İnceleme</a>
            <a asp-controller="Review" asp-action="GarageFinder">Servis Bul</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <span>PitStop · Araç sahiplerinin deneyim deposu</span>
        <span>Örnek veriler eğitim amaçlıdır.</span>
    </footer>
</body>
</html>
