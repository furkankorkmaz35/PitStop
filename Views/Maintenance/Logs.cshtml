@model IEnumerable<PitStop.Models.MaintenanceLog>

@{
    ViewData["Title"] = "Bakım Kayıtları";
    var totalCost = Model.Sum(log => log.Cost);
}

<section class="hero compact">
    <p class="eyebrow">BAKIM GEÇMİŞİ</p>
    <h1>Harcamalarını takip et.</h1>
    <p>Bakım tarihlerini ve maliyetlerini tek yerde gör.</p>
</section>

<section class="section">
    <div class="section-head">
        <div>
            <p class="eyebrow">ÖRNEK GARAJ</p>
            <h2>Son bakım kayıtları</h2>
        </div>
        <strong class="total">Toplam ₺@totalCost.ToString("N0")</strong>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Araç</th>
                    <th>İşlem</th>
                    <th>Parça</th>
                    <th>Servis</th>
                    <th>Maliyet</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.Date</td>
                        <td><strong>@log.Vehicle</strong></td>
                        <td>@log.Operation</td>
                        <td>@log.Part</td>
                        <td>@log.Service</td>
                        <td><strong>₺@log.Cost.ToString("N0")</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="muted">Görünen kayıtlar örnek amaçlıdır.</p>
</section>
